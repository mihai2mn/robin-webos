diff --git a/cmake/WebOSPackage.cmake b/cmake/WebOSPackage.cmake
index 4791e72..d833c67 100644
--- a/cmake/WebOSPackage.cmake
+++ b/cmake/WebOSPackage.cmake
@@ -8,6 +8,7 @@
 #     VENDOR <"Vendor">
 #     ICON <80x80 png>  LARGE_ICON <130x130 png>
 #     [ICON_COLOR <#rrggbb>]
+#     [REQUIRED_MEMORY <MB>]             appinfo.json requiredMemory: what memchute wants free before it launches the app
 #     [SUPPORT_GIP]                      appinfo.json "supportGIP": true; webOS 3.x's launcher shows a dark tile
 #                                        instead of the icon without it (reported on an OLED B7, webOS 3.9)
 #     [EXPECTED_NEEDED <file>]           reviewed DT_NEEDED list for the executable
@@ -47,7 +48,7 @@ set(WNK_PACKAGE_MODULE_DIR "${CMAKE_CURRENT_LIST_DIR}")
 set(WNK_TOOLS_DIR "${CMAKE_CURRENT_LIST_DIR}/../tools")
 
 function(wnk_add_webos_package)
