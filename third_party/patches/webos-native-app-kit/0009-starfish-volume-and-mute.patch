+// The element's volume and mute (the page's <video>), for this stream and the ones after it. The firmware's setVolume only
+// takes effect on a loaded stream (it answers false before). They go out at once, and again with the first Feed of a
+// stream (a call between Load and the first unit may land before the pipeline has its audio side up). load_completed_
+// is not used: webOS 5's events never carry the string it waits for.
+void StarfishBackend::set_volume(int percent, bool muted) {
+    void *object = nullptr;
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        volume_pct_ = std::clamp(percent, 0, 100);
+        muted_ = muted;
+        volume_dirty_ = !volume_fed_;
+        if (loaded_) object = object_;
+        percent = volume_pct_;
+    }
+    if (object != nullptr) apply_volume(object, percent, muted);
+}
+
+void StarfishBackend::apply_volume(void *object, int percent, bool muted) {
+    const Api &a = api();
+    if (a.set_volume == nullptr && a.set_audio_mute == nullptr) {
+        WNK_LOGI(kCat, "volume: this firmware has no setVolume/setAudioMute");
+        return;
+    }
+    // Muted: volume 0 as well as the mute flag (the unmute restores both), in case a firmware ignores one of them.
+    char json[128];
+    std::snprintf(json, sizeof json, "{\"volume\":%d,\"ease\":{\"duration\":0,\"type\":\"Linear\"}}", muted ? 0 : percent);
+    const int v = a.set_volume != nullptr ? (a.set_volume(object, json) & 0xFF) : -1;
+    const int m = a.set_audio_mute != nullptr ? (a.set_audio_mute(object, muted ? "{\"isMuteOn\":true}" : "{\"isMuteOn\":false}") & 0xFF) : -1;
+    WNK_LOGI(kCat, "volume %d%%%s: setVolume -> %d, setAudioMute -> %d", percent, muted ? " (muted)" : "", v, m);
+}
