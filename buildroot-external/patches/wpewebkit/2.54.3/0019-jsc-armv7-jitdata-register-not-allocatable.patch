From: Wren <wren@localhost>
Subject: [PATCH] JSC: r11 (jitDataRegister) is not an allocatable register on ARMv7

On ARM_THUMB2 GPRInfo::regCS1 (r11) is the dedicated jitDataRegister (BaselineJITData / DFG::JITData, the base
the DataIC code addresses the property caches through), but it was still the last entry of the allocatable register
file (numberOfRegisters = 10, toRegister(9) == regCS1). With the DFG's property caches in 2.54 DataIC form (the
following patch) the DFG register allocator handed r11 out as an ordinary scratch register and clobbered the JITData
pointer; the next IC then read a garbage cache (null handler, call through a data pointer). x86-64, ARM64 and RISC-V
already keep jitDataRegister out of their register file.

Shrink the file to the 9 registers r0-r5, r8-r10. Baseline/LLInt never allocated r11 (the first five scratch registers
of every baseline IC are earlier in the file), so this only changes the DFG and the scratch-register arrays.
---
diff --git a/Source/JavaScriptCore/jit/GPRInfo.h b/Source/JavaScriptCore/jit/GPRInfo.h
--- a/Source/JavaScriptCore/jit/GPRInfo.h
+++ b/Source/JavaScriptCore/jit/GPRInfo.h
@@ -473,7 +473,10 @@
 class GPRInfo {
 public:
     typedef GPRReg RegisterType;
-    static constexpr unsigned numberOfRegisters = 10;
+    // r11 (regCS1) is the dedicated jitDataRegister (baseline BaselineJITData / DFG JITData), so it is not an
+    // allocatable register. Leaving it in the file let the DFG register allocator hand it out as a scratch
+    // register and clobber the JITData pointer that the DataIC code addresses the property caches through.
+    static constexpr unsigned numberOfRegisters = 9;
     static constexpr unsigned numberOfArgumentRegisters = NUMBER_OF_ARGUMENT_REGISTERS;
 
     // Temporary registers.
@@ -525,7 +528,7 @@
     static constexpr GPRReg toRegister(unsigned index)
     {
         ASSERT_UNDER_CONSTEXPR_CONTEXT(index < numberOfRegisters);
-        constexpr GPRReg registerForIndex[numberOfRegisters] = { regT0, regT1, regT2, regT3, regT4, regT5, regT6, regT7, regCS0, regCS1 };
+        constexpr GPRReg registerForIndex[numberOfRegisters] = { regT0, regT1, regT2, regT3, regT4, regT5, regT6, regT7, regCS0 };
         return registerForIndex[index];
     }
 
@@ -541,7 +544,7 @@
         ASSERT(reg != InvalidGPRReg);
         ASSERT(static_cast<int>(reg) < 16);
         static const unsigned indexForRegister[16] =
-            { 0, 1, 2, 3, 4, 5, InvalidIndex, InvalidIndex, 6, 7, 8, 9, InvalidIndex, InvalidIndex, InvalidIndex, InvalidIndex };
+            { 0, 1, 2, 3, 4, 5, InvalidIndex, InvalidIndex, 6, 7, 8, InvalidIndex, InvalidIndex, InvalidIndex, InvalidIndex, InvalidIndex };
         unsigned result = indexForRegister[reg];
         return result;
     }
