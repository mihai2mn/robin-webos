+    auto signalValue = m_jsController->getDirect(vm, builtinNames(vm.get()).signalPrivateName());
+    auto* jsSignal = dynamicDowncast<JSAbortSignal>(signalValue);
+    return jsSignal ? RefPtr { &jsSignal->wrapped() } : nullptr;
+}
