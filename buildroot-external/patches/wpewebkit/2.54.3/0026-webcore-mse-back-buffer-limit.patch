+MediaTime SourceBufferPrivateGStreamer::platformMaximumBackBufferDuration() const
+{
+    // Seconds of played media kept behind the playhead: MSE_MAX_BACK_BUFFER_SECONDS (default 30, at least 3,
+    // 0 = no limit). Without it plain MediaSource keeps everything played until the byte limit is reached.
+    static const MediaTime duration = [] {
+        int64_t seconds = 30;
+        if (const char* value = getenv("MSE_MAX_BACK_BUFFER_SECONDS")) {
+            if (auto parsed = parseInteger<int64_t>(StringView::fromLatin1(value), 10))
+                seconds = *parsed;
+        }
+        if (seconds <= 0)
+            return MediaTime::invalidTime();
+        return MediaTime(std::clamp<int64_t>(seconds, 3, 86400), 1);
+    }();
+    return duration;
+}
