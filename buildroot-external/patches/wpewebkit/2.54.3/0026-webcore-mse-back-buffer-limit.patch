+void SourceBufferPrivate::evictBackBufferInternal(const MediaTime& currentTime)
+{
+    assertIsCurrent(m_dispatcher.get());
+
+    // Same removal as the first phase of evictFrames(): from the start of the buffered media up to the last
+    // sync sample before currentTime (never into the GOP being played), here also at most currentTime - keep.
+    MediaTime keep = platformMaximumBackBufferDuration();
+    if (!keep.isValid() || !keep.isFinite() || !currentTime.isFinite())
+        return;
+
+    // The playhead moved back since the last check (a seek): see evictFarAheadAfterSeekInternal().
+    bool jumpedBack = m_lastBackBufferCheckTime.isValid() && currentTime + MediaTime(5, 1) < m_lastBackBufferCheckTime;
+    m_lastBackBufferCheckTime = currentTime;
+    if (jumpedBack)
+        evictFarAheadAfterSeekInternal(currentTime, keep);
+
+    if (currentTime <= keep)
+        return;
+
+    MediaTime rangeStart = minimumBufferedTime();
+    if (!rangeStart.isValid() || !rangeStart.isFinite())
+        return;
+    MediaTime rangeEnd = std::min(currentTime - keep, findPreviousSyncSamplePresentationTime(currentTime));
+    if (rangeStart >= rangeEnd)
+        return;
+
+#if !RELEASE_LOG_DISABLED
+    uint64_t initialBufferedSize = evictionData().contentSize;
+#endif
+    removeCodedFramesInternal(rangeStart, rangeEnd, currentTime);
+    computeEvictionData();
+#if !RELEASE_LOG_DISABLED
+    DEBUG_LOG(LOGIDENTIFIER, "back buffer: removed [", rangeStart, ", ", rangeEnd, "), ", initialBufferedSize - evictionData().contentSize, " bytes, currentTime = ", currentTime);
+#endif
+}
+
+void SourceBufferPrivate::evictFarAheadAfterSeekInternal(const MediaTime& currentTime, const MediaTime& keep)
+{
+    assertIsCurrent(m_dispatcher.get());
+
+    // After a seek back out of the buffered media the player re-fetches from the new position, while what it had
+    // buffered ahead of the old position stays, far beyond the playhead: the re-fetched data would come on top of
+    // it. Keep `keep` seconds ahead of the new playhead and drop the rest. Never the range being played: when every
+    // track has currentTime buffered (a seek inside the buffer, nothing is re-fetched) nothing is removed.
+    bool playheadBuffered = true;
+    iterateTrackBuffers([&](TrackBuffer& trackBuffer) {
+        if (!trackBuffer.buffered().contain(currentTime))
+            playheadBuffered = false;
+    });
+    if (playheadBuffered)
+        return;
+
+    MediaTime rangeStart = currentTime + keep;
+    MediaTime rangeEnd = maximumBufferedTime();
+    if (!rangeEnd.isValid() || !rangeEnd.isFinite() || rangeStart >= rangeEnd)
+        return;
+
+#if !RELEASE_LOG_DISABLED
+    uint64_t initialBufferedSize = evictionData().contentSize;
+#endif
+    removeCodedFramesInternal(rangeStart, rangeEnd, currentTime);
+    computeEvictionData();
+#if !RELEASE_LOG_DISABLED
+    DEBUG_LOG(LOGIDENTIFIER, "seek back: removed far-ahead [", rangeStart, ", ", rangeEnd, "), ", initialBufferedSize - evictionData().contentSize, " bytes, currentTime = ", currentTime);
+#endif
+}
+
 bool SourceBufferPrivate::evictCodedFramesInternal(uint64_t newDataSize, const MediaTime& currentTime)
 {
     // If the algorithm here is modified, computeEvictionData() must be updated accordingly.
