+    // Needed by DFGSpeculativeJIT::compileStringSlice/compileStringSubstr (shared 32_64 code),
+    // which computes size = max(0, min(length, temp)) as
+    //     moveConditionally32(LessThan, temp, TrustedImm32(0), TrustedImm32(0), temp, temp)
+    // ARM64/X86_64 already have this immediate-thenCase form; ARMv7 only had the RegisterID one.
+    // Inside an IT block move(thenCase) must be one instruction (mov/mvn of an encodable immediate). Other
+    // immediates (movw+movt) go through addressTempRegister, set before the compare, and the register form.
+    static bool isSingleInstructionImm32(TrustedImm32 imm)
+    {
+        return ARMThumbImmediate::makeEncodedImm(imm.m_value).isValid() || ARMThumbImmediate::makeEncodedImm(~imm.m_value).isValid();
+    }
+
+    void moveConditionally32(RelationalCondition cond, RegisterID left, TrustedImm32 right, TrustedImm32 thenCase, RegisterID elseCase, RegisterID dest)
+    {
+        if (!isSingleInstructionImm32(thenCase)) {
+            move(thenCase, addressTempRegister);
+            moveConditionally32(cond, left, right, addressTempRegister, elseCase, dest);
+            return;
+        }
+        if (!right.m_value) {
+            if (auto resultCondition = commuteCompareToZeroIntoTest(cond)) {
+                moveConditionallyTest32(*resultCondition, left, left, thenCase, elseCase, dest);
+                return;
+            }
+        }
+
+        compare32AndSetFlags(left, right);
+        if (elseCase == dest) {
+            m_assembler.it(armV7Condition(cond));
+            move(thenCase, dest);
+        } else {
+            m_assembler.it(armV7Condition(cond), false);
+            move(thenCase, dest);
+            move(elseCase, dest);
+        }
+    }
+
+    // RegisterID/TrustedImm32-thenCase form, mirroring MacroAssemblerARM64.h. Reached from
+    // moveConditionally32()'s zero-immediate specialisation, which passes thenCase as an immediate.
+    void moveConditionallyTest32(ResultCondition cond, RegisterID left, RegisterID right, TrustedImm32 thenCase, RegisterID elseCase, RegisterID dest)
+    {
+        if (!isSingleInstructionImm32(thenCase)) {
+            move(thenCase, addressTempRegister);
+            moveConditionallyTest32(cond, left, right, addressTempRegister, elseCase, dest);
+            return;
+        }
+        m_assembler.tst(left, right);
+        if (elseCase == dest) {
+            m_assembler.it(armV7Condition(cond));
+            move(thenCase, dest);
+        } else {
+            m_assembler.it(armV7Condition(cond), false);
+            move(thenCase, dest);
+            move(elseCase, dest);
+        }
+    }
+
