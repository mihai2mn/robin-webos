+// 64-bit: DFGSpeculativeJIT64.cpp. MapStorage feeds JSMapIterator/JSSetIterator's Storage internal field (the
+// FastMap/FastSet iterator-open path in DFGByteCodeParser has no is64Bit() guard). The storage pointer is null
+// until the map/set has storage; on 64-bit a null pointer is the empty JSValue, which the runtime checks for.
+// On 32-bit the empty JSValue is a different tag/payload pair, so produce it explicitly: EmptyValueTag/0 for a
+// null storage pointer, CellTag/pointer otherwise.
+void SpeculativeJIT::compileMapStorage(Node* node)
+{
+    SpeculateCellOperand map(this, node->child1());
+    GPRTemporary resultTag(this);
+    GPRTemporary resultPayload(this);
+
+    GPRReg mapGPR = map.gpr();
+    GPRReg resultTagGPR = resultTag.gpr();
+    GPRReg resultPayloadGPR = resultPayload.gpr();
+
+    if (node->child1().useKind() == MapObjectUse) {
+        speculateMapObject(node->child1(), mapGPR);
+        loadPtr(Address(mapGPR, JSMap::offsetOfStorage()), resultPayloadGPR);
+    } else if (node->child1().useKind() == SetObjectUse) {
+        speculateSetObject(node->child1(), mapGPR);
+        loadPtr(Address(mapGPR, JSSet::offsetOfStorage()), resultPayloadGPR);
+    } else
+        RELEASE_ASSERT_NOT_REACHED();
+
+    move(TrustedImm32(JSValue::CellTag), resultTagGPR);
+    auto hasStorage = branchTestPtr(NonZero, resultPayloadGPR);
+    move(TrustedImm32(JSValue::EmptyValueTag), resultTagGPR);
+    hasStorage.link(this);
+
+    jsValueResult(resultTagGPR, resultPayloadGPR, node);
+}
+#endif // USE(JSVALUE32_64)
