+#if USE(JSVALUE32_64)
+    // Moves N JSValues into the fixed registers the baseline DataIC handlers expect. A payload-only source is a
+    // known cell, so its destination tag register is set to JSValue::CellTag.
+    template<unsigned N>
+    void shuffleOperandsForDataIC(std::array<JSValueRegs, N> sources, std::array<JSValueRegs, N> destinations)
+    {
+        std::array<GPRReg, N * 2> sourceRegs;
+        std::array<GPRReg, N * 2> destinationRegs;
+        for (unsigned i = 0; i < N; ++i) {
+            sourceRegs[i] = sources[i].payloadGPR();
+            destinationRegs[i] = destinations[i].payloadGPR();
+            sourceRegs[i + N] = sources[i].tagGPR() == InvalidGPRReg ? sources[i].payloadGPR() : sources[i].tagGPR();
+            destinationRegs[i + N] = destinations[i].tagGPR();
+        }
+        shuffleRegisters<GPRReg, N * 2>(sourceRegs, destinationRegs);
+        for (unsigned i = 0; i < N; ++i) {
+            if (sources[i].tagGPR() == InvalidGPRReg)
+                move(TrustedImm32(JSValue::CellTag), destinations[i].tagGPR());
+        }
+    }
 #endif
 
     void compileDeleteById(Node*);
