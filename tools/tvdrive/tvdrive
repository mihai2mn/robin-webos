#!/usr/bin/env bash
# tvdrive: drive the dev copy of Robin on the LG TV like a person with the remote, with screenshots.
# Works from Windows Git Bash and WSL (needs bash, ssh, scp, base64; ffmpeg optional, for small screenshots).
# See README.md. Env: TVDRIVE_HOST (ssh host, default lgtv), TVDRIVE_OUT (output dir, default ./tvdrive-out),
# TVDRIVE_APP (app id, default io.github.mihai2mn.robin.dev).
set -u
HOST=${TVDRIVE_HOST:-lgtv}
APP=${TVDRIVE_APP:-io.github.mihai2mn.robin.dev}
OUT=${TVDRIVE_OUT:-$PWD/tvdrive-out}
DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
RUN=/tmp/$APP
LOCKDIR=/tmp/wren-devapp.lock
LOCK_STALE_MIN=25   # a lock older than this is shown as stale (it is never taken over by itself)
# the TV-side files of shot/frames carry the owner's name, so two owners never write the same file
TAG=${TVDRIVE_OWNER:-pid$$}; TAG=${TAG//[^A-Za-z0-9_.-]/_}
REMOTE_PATH='export PATH=/opt/bin:/opt/sbin:$PATH;'

case "$APP" in *.dev) ;; *) echo "tvdrive: refusing to touch the real app $APP (only a *.dev id)" >&2; exit 2 ;; esac

tvssh() { timeout "${TVDRIVE_TIMEOUT:-120}" ssh -o BatchMode=yes -o ConnectTimeout=100 "$HOST" "$@"; }
tvsh()  { tvssh "$REMOTE_PATH $1"; }
# run the TV-side input helper: ti CMD ARGS...
ti() { local a="" x; for x in "$@"; do a="$a $(printf '%q' "$x")"; done
       tvssh "/opt/bin/python3 - $a" < "$DIR/tvinput.py"; }
die() { echo "tvdrive: $*" >&2; exit 1; }
num() { case "$1" in ''|*[!0-9-]*) die "not a number: '$1'";; esac; }
sq()  { printf "'%s'" "${1//\'/\'\\\'\'}"; }
now() { date +%H%M%S; }
ffm() { command -v ffmpeg 2>/dev/null || command -v ffmpeg.exe 2>/dev/null; }

usage() { cat <<'EOF'
tvdrive <command> [args]   (screen is 1920x1080; x y are screenshot pixels)
  shot [file]            screenshot -> file (default $TVDRIVE_OUT/shot-HHMMSS.png) + file-small.jpg (640 px wide)
  open <url> [--fresh] [--wait S]   open a URL in the dev app (--fresh closes the app first); waits S s (default 8)
  click x y              move the pointer to x,y and click
  move x y               move the pointer to x,y (absolute)
  nudge dx dy            move the pointer relative to where it is (units; ~3.1 px each)
  scroll dy [x y]        wheel: dy>0 = down, <0 = up (one unit ~ 60 screen px), pointer first goes to x y (default 960 600)
  drag x1 y1 x2 y2       move to x1,y1, move to x2,y2 with the button flag set (the TV's input socket delivers no
                         button press to the app, so this does NOT select text or drag sliders; it only moves)
  key <name>...          remote keys: up down left right ok back home red green yellow blue ch+ ch- play pause
                         stop rew ff info 0-9 ... (or any raw network-input name, e.g. LIST); "ok" = ENTER
  type "text"            text into the focused page field by clicking LG's on-screen keyboard (opens when a field is
                         focused: click the field first). Letters, digits, space . , @ ? ; \n = Enter, \b = backspace
  log [n]                last n (default 40) lines of events.log + engine.log; "log --follow" streams events.log
  state                  foreground app, memory, swap, web process RSS, app pids
  lock <owner> | unlock <owner>   the shared dev-app lock (/tmp/wren-devapp.lock); hold it <= 25 min. Every command that uses the
                         screen or the app (all but log, state, lock, unlock) needs TVDRIVE_OWNER to be exactly the lock's owner while
                         one is held; an unreadable or half-written lock stops them too.
  close                  close the dev app
  frames [seconds] [--fps N] [dir]   what the SCREEN did, as text: a burst of small screen captures (default 4 s at
                         10 per second; includes the video plane and the toolbar) reduced by frames.js to
                         static / changing / FLICKER stretches. Captures stay in dir ($TVDRIVE_OUT/frames-HHMMSS)
EOF
}

cmd=${1:-}; [ $# -gt 0 ] && shift
# The state of the dev-app lock, read in one ssh call: "free", "incomplete" (the directory exists but has no complete owner file:
# a lock being taken, or a dead one), or "held <age in seconds> <owner>". Fails (and so do the guarded commands) when the TV cannot be read.
lockstate() {
  tvssh "L=$LOCKDIR; if [ ! -d \$L ]; then echo free; elif [ -s \$L/owner ] && [ -n \"\$(sed -n 2p \$L/owner)\" ]; then echo held \$(( \$(date +%s) - \$(sed -n 2p \$L/owner) )) \$(head -n1 \$L/owner); else echo incomplete; fi" 2>/dev/null
}
lockage() { local s=$1; [ "$s" -ge 0 ] 2>/dev/null || { echo "age unknown"; return; }
  if [ "$s" -ge $((LOCK_STALE_MIN*60)) ]; then echo "held $((s/60)) min: STALE (older than $LOCK_STALE_MIN min; ask the owner, or unlock it by name)"; else echo "held $((s/60)) min"; fi; }
# Commands that use the TV's screen or the dev app refuse to run while another owner holds the dev-app lock. $TVDRIVE_OWNER must be
# exactly the lock's owner name. Fail closed: when the lock cannot be read (ssh failed) or is half-written, nothing runs.
# Two agents ran over each other's tests because they did not look at the answer of "lock".
case "$cmd" in open|close|move|nudge|click|scroll|drag|key|type|shot|frames)
  st=$(lockstate) || die "cannot read the TV's lock (ssh failed): not running '$cmd'"
  case "$st" in
    free) ;;
    incomplete) die "the TV's lock directory $LOCKDIR has no complete owner file (being taken, or dead): not running '$cmd'. If it stays so, remove it on the TV yourself." ;;
    held\ *) rest=${st#held }; age=${rest%% *}; held=${rest#* }
      [ "$held" = "${TVDRIVE_OWNER:-}" ] || die "the TV is locked by '$held' ($(lockage "$age")); you are '${TVDRIVE_OWNER:-unset}': not running '$cmd'. Take the lock first and export TVDRIVE_OWNER=<your lock name>." ;;
    *) die "unreadable lock state '$st': not running '$cmd'" ;;
  esac ;;
esac
case "$cmd" in
  ''|help|-h|--help) usage ;;

  shot)
    mkdir -p "$OUT"
    f=${1:-$OUT/shot-$(now).png}; mkdir -p "$(dirname "$f")"
    tvsh "tv shot /tmp/tvdrive-shot-$TAG.png >/dev/null" || die "shot failed"
    scp -q -o BatchMode=yes "$HOST:/tmp/tvdrive-shot-$TAG.png" "$f" || die "scp failed"
    tvsh "rm -f /tmp/tvdrive-shot-$TAG.png" >/dev/null 2>&1 || true
    echo "$f"
    ff=$(ffm)
    if [ -n "$ff" ]; then
      s="${f%.*}-small.jpg"
      "$ff" -y -loglevel error -i "$f" -vf scale=640:-1 -q:v 4 "$s" 2>/dev/null && echo "$s"
    fi ;;

  open)
    url=${1:-}; [ -n "$url" ] || die "open <url> [--fresh]"; shift
    fresh=0; wait=8
    while [ $# -gt 0 ]; do case "$1" in --fresh) fresh=1;; --wait) wait=${2:-}; shift;; esac; shift; done
    num "$wait"
    esc=${url//\\/\\\\}; esc=${esc//\"/\\\"}
    payload="{\"target\":\"$esc\"}"
    if [ $fresh = 1 ]; then tvsh "tv close $(sq "$APP") >/dev/null 2>&1; sleep 2"; fi
    tvsh "tv launch $(sq "$APP") $(sq "$payload")" || die "launch failed"
    sleep "$wait" ;;

  close) tvsh "tv close $(sq "$APP")" ;;

  frames)
    secs=4; fps=10; d=""
    while [ $# -gt 0 ]; do case "$1" in --fps) fps=$2; shift;; ''|*[!0-9]*) d=$1;; *) secs=$1;; esac; shift; done
    num "$secs"; num "$fps"; [ "$fps" -ge 1 ] && [ "$fps" -le 25 ] || die "--fps 1..25"
    d=${d:-$OUT/frames-$(now)}; mkdir -p "$d"
    ff=$(ffm); [ -n "$ff" ] || die "frames needs ffmpeg"
    # One capture takes about 40 ms on the TV; the pause between captures keeps the rate (and the load) down.
    gap=$(( 1000000 / fps - 40000 )); [ "$gap" -lt 0 ] && gap=0
    tvssh "sh -s $secs $gap $TAG" < "$DIR/tvframes.sh" || die "capture failed"
    scp -q -o BatchMode=yes "$HOST:/tmp/tvdrive-frames-$TAG.tar" "$d/frames.tar" || die "scp failed"
    tvsh "rm -f /tmp/tvdrive-frames-$TAG.tar"
    tar xf "$d/frames.tar" -C "$d" && rm -f "$d/frames.tar"
    if ! ls "$d"/f*.jpg >/dev/null 2>&1; then
      echo "tvdrive frames: the TV's capture service wrote no frame file." >&2
      [ -s "$d/errors.txt" ] && { echo "its answers:" >&2; sed 's/^/  /' "$d/errors.txt" >&2; }
      echo "(screenshots may still work: try 'tvdrive shot'; see tools/tvdrive/README.md, Screen traces)" >&2
      exit 1
    fi
    "$ff" -y -loglevel error -start_number 0 -i "$d/f%05d.jpg" -vf scale=32:18:flags=area,format=gray -f rawvideo "$d/frames.raw" || die "ffmpeg failed"
    node "$DIR/frames.js" "$d/frames.raw" "$d/times.txt" | tee "$d/frames.txt"
    echo "captures: $d" ;;

  move)   num "${1:-}"; num "${2:-}"; ti abs "$1" "$2" ;;
  nudge)  num "${1:-}"; num "${2:-}"; ti move "$1" "$2" ;;
  click)  num "${1:-}"; num "${2:-}"; ti click "$1" "$2" ;;
  scroll) num "${1:-}"; x=${2:-960}; y=${3:-600}; ti scroll "$1" "$x" "$y" ;;
  drag)   for i in 1 2 3 4; do num "${!i:-}"; done; ti drag "$1" "$2" "$3" "$4" ;;

  key)
    [ $# -gt 0 ] || die "key <name>..."
    names=()
    for k in "$@"; do
      case "$(echo "$k" | tr 'A-Z' 'a-z')" in
        ok|enter|select) n=ENTER;; up) n=UP;; down) n=DOWN;; left) n=LEFT;; right) n=RIGHT;;
        back|return) n=BACK;; home) n=HOME;; exit) n=EXIT;; red) n=RED;; green) n=GREEN;; yellow) n=YELLOW;; blue) n=BLUE;;
        ch+|chup|channelup) n=CHANNELUP;; ch-|chdown|channeldown) n=CHANNELDOWN;;
        play) n=PLAY;; pause) n=PAUSE;; stop) n=STOP;; rew|rewind) n=REWIND;; ff|fastforward) n=FASTFORWARD;;
        info) n=INFO;; menu) n=MENU;; list) n=LIST;; mute) n=MUTE;; vol+) n=VOLUMEUP;; vol-) n=VOLUMEDOWN;;
        *) n=$k;;
      esac
      names+=("$n")
    done
    ti key "${names[@]}" ;;

  type)
    [ $# -gt 0 ] || die 'type "text"'
    # A trailing \n is the text's last character (Enter): command substitution would strip it, so a sentinel goes round it.
    txt=$(printf '%b.' "$1"); txt=${txt%.}
    b=$(printf '%s' "$txt" | base64 | tr -d '\n')
    ti type "$b" ;;

  log)
    if [ "${1:-}" = "--follow" ] || [ "${1:-}" = "-f" ]; then
      tvssh "tail -n 20 -f $(sq "$RUN/events.log")"
    else
      n=${1:-40}; num "$n"
      echo "== events.log (last $n)"; tvssh "tail -n $n $(sq "$RUN/events.log")"
      echo "== engine.log (last $n)"; tvssh "tail -n $n $(sq "$RUN/engine.log")"
    fi ;;

  state)
    tvsh "
echo \"foreground: \$(tv 2>/dev/null | grep -m1 'On screen')\"
grep -E 'MemTotal|MemAvailable|SwapTotal|SwapFree' /proc/meminfo | tr -s ' ' | tr '\n' ';'; echo
for p in \$(ps | grep -E 'wpebrowser|wpe-engine|WPEWebProc|WPENetworkProc' | grep -v grep | awk '{print \$1}'); do
  echo \"pid \$p \$(cat /proc/\$p/comm) rss_kb=\$(awk '/VmRSS/{print \$2}' /proc/\$p/status)\"
done
echo \"events.log tail:\"; tail -n 2 $RUN/events.log | cut -c1-170
echo \"lock: \$(head -n1 $LOCKDIR/owner 2>/dev/null || echo free) (since epoch \$(sed -n 2p $LOCKDIR/owner 2>/dev/null), now \$(date +%s))\"" ;;

  lock)
    owner=${1:-}; [ -n "$owner" ] || die "lock <owner-name>"
    # mkdir is the atomic step; the owner file is written whole (name and time) under a temporary name and renamed, so no reader ever
    # sees a half-written owner; when the write fails the directory this call made is removed again.
    if tvsh "mkdir $LOCKDIR 2>/dev/null && { { printf '%s\n%s\n' $(sq "$owner") \$(date +%s) > $LOCKDIR/owner.tmp && mv $LOCKDIR/owner.tmp $LOCKDIR/owner; } || { rm -rf $LOCKDIR; exit 1; }; }"; then echo "lock taken by $owner (hold <= $LOCK_STALE_MIN min)"
    else st=$(lockstate) || st="unreadable (ssh failed)"
      case "$st" in held\ *) rest=${st#held }; echo "lock held by: ${rest#* } ($(lockage "${rest%% *}"))" ;; *) echo "lock not taken: state $st" ;; esac; exit 1; fi ;;
  unlock)
    owner=${1:-}; [ -n "$owner" ] || die "unlock <owner-name>"
    cur=$(tvssh "head -n1 $LOCKDIR/owner 2>/dev/null; true") || die "cannot read the TV's lock (ssh failed): not releasing"
    if [ "$cur" = "$owner" ]; then tvssh "rm -rf $LOCKDIR" && echo "lock released"
    else echo "not released: lock owner is '${cur:-nobody}', not '$owner'"; exit 1; fi ;;

  *) usage; exit 2 ;;
esac
